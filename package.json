{
  "name": "tell-me-more",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["web", "sanity"],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "eslint web packages tests scripts sanity/schemaTypes sanity/sanity.config.ts",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p sanity/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "verify:sanity": "tsx scripts/verify-sanity.ts",
    "studio": "npm run dev --workspace sanity",
    "schema:deploy": "npm exec --workspace sanity -- sanity schema deploy"
  },
  "dependencies": {"@sanity/client": "^7.0.0", "@modelcontextprotocol/sdk": "^1.0.0", "zod": "^4.0.0"},
  "devDependencies": {"typescript": "^5.9.0", "tsx": "^4.0.0", "vitest": "^4.0.0", "@playwright/test": "^1.0.0", "@types/node": "^24.0.0", "eslint": "^9.0.0", "eslint-config-next": "16.3.5"}
}
