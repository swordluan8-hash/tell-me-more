# Storage mode. Public deployment uses Sanity read access.
TMM_STORAGE=local-demo

# Public judge deployment: synthetic read-only data + fixed non-persistent Context preview.
TMM_PUBLIC_DEMO=false

# Public Sanity project metadata.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_CONTEXT_MCP_URL=
SANITY_KNOWLEDGE_BASE_ID=

# Server-side Context token only. Never commit a real value.
SANITY_ORGANIZATION_TOKEN=
